server {
    listen 8080;
    host 127.0.0.1;
    server_name principal.test;
    client_max_body_size 100;
    root ./www/html;
    index index.html;
    location / {
        methods GET POST;
        root ./www/html;
        index index.html;
    }
    location /post_body {
        methods POST;
    }
    location /old-page {
        return 301 /new-page.html;
    }
}
server {
    listen 9090;
    host 127.0.0.1;
    server_name secundario.com;
    root ./www/html;
    location / {
        methods GET;
        root ./www/html;
    }
}
