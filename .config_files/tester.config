server {
    listen 8080;
    host 127.0.0.1;
    server_name localhost;
    root ./www/html;
    index index.html;
    client_max_body_size 100;

    location / {
        methods GET;
    }

    location /post_body {
        methods POST;
    }

    location /directory/ {
        methods GET;
        root ./YoupiBanane;
        index youpi.bad_extension;
        autoindex on;
    }

    location /cgi-bin {
        methods POST;
        root ./YoupiBanane;
        cgi_ext .bla;
        cgi_path ./www/cgi-bin/cgi_tester;
    }
}
