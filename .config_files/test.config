# Define un bloque de servidor para agrupar la configuración de un sitio web específico
server {
    # Puerto en el que el servidor escuchará las conexiones entrantes
    listen 8080;

    # Dirección IP o host al que se vinculará este servidor para escuchar peticiones
    host 127.0.0.1;

    # Nombres de dominio o servidores virtuales asignados a este bloque de servidor
    server_name webserv.local www.webserv.local;

    # Directorio raíz del sistema de archivos donde se buscarán los recursos solicitados por el cliente
    # root /home/cochatel/Escola42/5_circle/webserver/www/html;
    root /home/corentin/Escola42/webserver/www/html;

    # Archivo por defecto que se servirá automáticamente si la solicitud del cliente es un directorio
    index index.html;

    # Límite máximo permitido para el cuerpo de una petición HTTP del cliente (en bytes)
    client_max_body_size 2097152;

    # Configuración específica aplicable a una ruta o URL raíz
    location / {
        # Lista de métodos HTTP permitidos para interactuar con los recursos de esta ruta
        methods GET POST DELETE;

        # Directiva alternativa idéntica para especificar los métodos HTTP autorizados en la ruta
        allow_methods GET POST;

        # Activa o desactiva el listado automático de archivos del directorio si no existe un archivo index
        autoindex on;
    }

    # Configuración específica para el procesamiento y almacenamiento de subidas de archivos
    location /uploads {
        # Carpeta física en el servidor donde se guardarán permanentemente los archivos subidos por los clientes
        upload_store /var/www/html/uploads;

        # Métodos HTTP autorizados en esta localización para permitir la subida (POST) y el borrado (DELETE) de recursos
        methods POST DELETE;
    }

    # Configuración utilizada para redirigir el tráfico de una ruta vieja a otra ubicación
    location /old-page {
        # Redirección HTTP que devuelve un código o una cadena con la URL de destino configurada
        return 301 /new-page;
    }

    # Bloque de configuración dedicado exclusivamente a la ejecución de scripts CGI
    location /cgi {
        # Directorio raíz físico del servidor donde se localizan y ejecutan los scripts CGI relativos
        # root /var/www/html/cgi-bin;
        # root /home/datienza/Desktop/webserv;
	root /home/corentin/Escola42/webserver/www/cgi-bin; 

        # Métodos permitidos para interactuar con el entorno CGI, comúnmente lecturas y envío de formularios
        methods GET POST;

        # Mapa tradicional que asocia de forma directa una extensión de archivo con su binario ejecutable correspondiente
        cgi_info .php /usr/bin/php-cgi;

        # Extensiones de archivo que el servidor reconocerá y procesará como scripts CGI independientes en esta ruta
        cgi_ext .py .sh;

        # Rutas absolutas a los programas intérpretes encargados de ejecutar ordenadamente las extensiones configuradas
        cgi_path /usr/bin/python3 /usr/bin/bash;
    }
}
